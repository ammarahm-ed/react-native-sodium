{
  "name": "@ammarahmed/react-native-sodium",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyubo/react-native-sodium.git"
  },
  "version": "2.0.0-alpha.4",
  "description": "The Sodium crypto library for React Native.",
  "author": "Lyubomir Ivanov",
  "main": "index.ts",
  "nativePackage": true,
  "license": "ISC",
  "homepage": "https://github.com/lyubo/react-native-sodium",
  "private": false,
  "keywords": [
    "react-native",
    "crypto",
    "nacl",
    "sodium"
  ],
  "codegenConfig": {
    "name": "RNSodiumSpec",
    "type": "modules",
    "jsSrcsDir": "spec",
    "android": {
      "javaPackageName": "org.libsodium.rn"
    },
    "ios": {
      "modulesProvider": {
        "Sodium": "RCTSodium"
      }
    }
  }
}
