{
  "extends": "@react-native/typescript-config",
  "include": [
    "App.tsx",
    "index.js",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "react-native": [
        "./node_modules/react-native"
      ],
      "@ammarahmed/react-native-sodium": [
        ".."
      ]
    }
  }
}
